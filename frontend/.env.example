# Zustand Store Environment Configuration

# API Configuration
VITE_API_URL=http://localhost:3000/api
VITE_API_TIMEOUT=30000

# Store Configuration
VITE_ENABLE_ZUSTAND_DEVTOOLS=true
VITE_AUTO_SYNC_INTERVAL=5000
VITE_PERSIST_STORE=true

# Storage Configuration
VITE_USE_INDEXEDDB=true
VITE_INDEXEDDB_NAME=academics-portal
VITE_INDEXEDDB_VERSION=1

# Feature Flags
VITE_ENABLE_OPTIMISTIC_UPDATES=true
VITE_ENABLE_AUTO_SAVE=true
VITE_AUTO_SAVE_DELAY=3000

# Debug
VITE_DEBUG_STORE_ACTIONS=false
VITE_DEBUG_API_CALLS=false
